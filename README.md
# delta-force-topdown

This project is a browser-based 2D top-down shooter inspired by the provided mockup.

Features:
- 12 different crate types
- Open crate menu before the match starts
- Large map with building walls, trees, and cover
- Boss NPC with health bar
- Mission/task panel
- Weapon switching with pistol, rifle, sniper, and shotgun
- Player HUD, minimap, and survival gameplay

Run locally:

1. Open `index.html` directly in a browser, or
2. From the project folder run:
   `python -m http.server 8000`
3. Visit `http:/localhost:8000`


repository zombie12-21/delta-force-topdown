};

function randomRange(min, max) {
  return Math.random() * (max - min) + min;
}

function clamp(value, min, max) {
  return Math.max(min, Math.min(max, value));
}

function buildMap() {
  obstacles.length = 0;

  const buildingRects = [
    { x: 760, y: 420, w: 380, h: 300 },
    { x: 160, y: 1120, w: 220, h: 230 },
    { x: 1220, y: 980, w: 320, h: 220 },
    { x: 1500, y: 420, w: 260, h: 210 },
    { x: 880, y: 1160, w: 260, h: 240 },
    { x: 370, y: 350, w: 180, h: 150 }
  ];

  for (const rect of buildingRects) {
    obstacles.push({ type: 'building', ...rect });
  }

  const trees = [
    { x: 185, y: 270, r: 28 }, { x: 610, y: 230, r: 22 }, { x: 1040, y: 240, r: 30 }, { x: 1770, y: 260, r: 26 },
    { x: 2205, y: 420, r: 28 }, { x: 2060, y: 1040, r: 32 }, { x: 1220, y: 600, r: 24 }, { x: 600, y: 1440, r: 28 },
    { x: 1400, y: 1480, r: 30 }, { x: 1850, y: 1420, r: 24 }, { x: 2100, y: 1540, r: 30 }, { x: 300, y: 640, r: 22 }
  ];

  for (const tree of trees) {
    obstacles.push({ type: 'tree', x: tree.x, y: tree.y, r: tree.r });
  }

  const rocks = [
    { x: 980, y: 840, r: 18 }, { x: 780, y: 920, r: 14 }, { x: 1680, y: 990, r: 18 }, { x: 1340, y: 1230, r: 16 }
  ];

  for (const rock of rocks) {
    obstacles.push({ type: 'rock', x: rock.x, y: rock.y, r: rock.r });
  }
}

function createCrates() {
  crates.length = 0;
  for (let i = 0; i < 26; i++) {
    const template = crateTemplates[Math.floor(Math.random() * crateTemplates.length)];
    const x = randomRange(120, world.width - 120);
    const y = randomRange(120, world.height - 120);
    const safe = !isPositionBlocked(x, y, 24);

    if (!safe) continue;

    crates.push({
      x, y, r: 18,
      name: template.name,
      color: template.icon,
      loot: template.loot,
      opened: false,
      pulse: Math.random() * Math.PI * 2
    });
  }
}

function createEnemies() {
  enemies.length = 0;
  for (let i = 0; i < 13; i++) {
    enemies.push({
      x: randomRange(200, world.width - 200),
      y: randomRange(200, world.height - 200),
      radius: 14,
      health: 45,
      speed: 100 + Math.random() * 30,
      color: i % 2 === 0 ? '#d9534f' : '#8c97ff',
      attackCooldown: 0,
      alive: true
    });
  }
}

function resetGame() {
  player.x = 340;
  player.y = 1040;
  player.health = 100;
  player.armor = 0;
  player.weapon = 'pistol';
  player.aimMode = 'normal';
  player.ammoInMag = weaponCatalog.pistol.ammo;
  player.inventory.ammo = 120;
  player.inventory.medkits = 2;
  player.inventory.grenades = 2;
  player.inventory.coins = 0;
  player.inventory.keys = 0;
  player.weaponsUnlocked = ['pistol', 'rifle', 'sniper', 'shotgun'];
  bullets.length = 0;
  enemyBullets.length = 0;
  particles.length = 0;
  kills = 0;
  mapTimer = 0;
  boss.health = boss.maxHealth;
  boss.active = true;
  buildMap();
  createCrates();
  createEnemies();
  updateMissionUI();
  updatePlayerHud();
}

function isPositionBlocked(x, y, radius) {
  for (const o of obstacles) {
    if (o.type === 'building') {
      const nearestX = clamp(x, o.x, o.x + o.w);
      const nearestY = clamp(y, o.y, o.y + o.h);
      const dx = x - nearestX;
      const dy = y - nearestY;
      if (dx * dx + dy * dy < radius * radius) return true;
    } else if (o.type === 'tree' || o.type === 'rock') {
      const dx = x - o.x;
      const dy = y - o.y;
      if (dx * dx + dy * dy < (radius + o.r) * (radius + o.r)) return true;
    }
  }
  return false;
}

function updatePlayerHud() {
  hpValue.textContent = Math.ceil(player.health);
  armorValue.textContent = Math.ceil(player.armor);
  killValue.textContent = kills;
  ammoValue.textContent = `${player.ammoInMag}/${player.inventory.ammo}`;
  weaponLabel.textContent = weaponCatalog[player.weapon].name;

  document.querySelectorAll('.weapon-slot').forEach((slot, index) => {
    const isActive = index === player.lastWeaponIndex;
    slot.classList.toggle('active', isActive);
  });
}

function updateMissionUI() {
  missionList.innerHTML = '';
  missionListData.forEach((mission) => {
    const li = document.createElement('li');
    li.textContent = mission.text;
    if (mission.done) li.classList.add('done');
    missionList.appendChild(li);
  });
}

function renderCrateMenu() {
  crateList.innerHTML = '';
  crateTemplates.forEach((crate) => {
    const card = document.createElement('div');
    card.className = 'crate-card';
    card.innerHTML = `
      <span class="crate-icon" style="background:${crate.icon};"></span>
      <h3>${crate.name}</h3>
      <p>${crate.rarity}</p>
    `;
    card.addEventListener('click', () => {
      const rewards = ['ammo', 'medkit', 'armor', 'coins', 'rifle', 'sniper', 'grenade', 'supply'];
      const reward = rewards[Math.floor(Math.random() * rewards.length)];
      if (reward === 'ammo') player.inventory.ammo += 30;
      if (reward === 'medkit') player.inventory.medkits += 1;
      if (reward === 'armor') player.armor = Math.min(player.armor + 20, 100);
      if (reward === 'coins') player.inventory.coins += 100;
      if (reward === 'grenade') player.inventory.grenades += 1;
      if (reward === 'supply') player.inventory.medkits += 1;
      if (reward === 'rifle') player.weaponsUnlocked.push('rifle');
      if (reward === 'sniper') player.weaponsUnlocked.push('sniper');
      card.style.borderColor = '#ffd24d';
      setTimeout(() => card.style.borderColor = '', 400);
      updatePlayerHud();
    });
    crateList.appendChild(card);
  });
}

renderCrateMenu();

document.getElementById('openRandomBtn').addEventListener('click', () => {
  const crate = crateTemplates[Math.floor(Math.random() * crateTemplates.length)];
  const reward = crate.loot;
  if (reward === 'ammo') player.inventory.ammo += 25;
  if (reward === 'med') player.inventory.medkits += 1;
  if (reward === 'armor') player.armor = Math.min(player.armor + 25, 100);
  if (reward === 'coins') player.inventory.coins += 80;
  if (reward === 'grenade') player.inventory.grenades += 1;
  if (reward === 'weapon') {
    const weaponChoices = ['rifle', 'sniper', 'shotgun'];
    const chosen = weaponChoices[Math.floor(Math.random() * weaponChoices.length)];
    if (!player.weaponsUnlocked.includes(chosen)) player.weaponsUnlocked.push(chosen);
    player.weapon = chosen;
  }
  if (reward === 'supply') player.inventory.ammo += 22;
  updatePlayerHud();
});

